<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DynamicIsland</AssemblyName>
    <RootNamespace>DynamicIsland</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.31.1</Version>
    <InformationalVersion>1.31.1</InformationalVersion>
    <UpdateRepository Condition="'$(UpdateRepository)' == ''">shapezopm/DynamicIsland</UpdateRepository>
    <PublishReadyToRun>false</PublishReadyToRun>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DefaultItemExcludes>$(DefaultItemExcludes);out/**;publish/**;backups/**;TestResults/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup Condition="'$(UpdateRepository)' != '' and '$(PublishSingleFile)' == 'true'">
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
  </ItemGroup>

  <ItemGroup Condition="'$(PluginRepository)' != ''">
    <AssemblyMetadata Include="PluginRepository" Value="$(PluginRepository)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Gadgets\*.png" />
    <Resource Include="Fonts\*.otf;Fonts\*.ttf" />
    <None Update="Fonts\Unbounded-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Remove="tests\**\*" />
    <None Remove="tests\**\*" />
    <InternalsVisibleTo Include="DynamicIsland.Lyrics.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.32" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />

    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

</Project>

