                    <Grid x:Name="WeatherContent">
                        <Border Width="216" Height="177" Margin="12,46,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#14FFFFFF" CornerRadius="22">
                            <Grid>
                                <local:Digits x:Name="WeatherDegrees" FontFamily="{StaticResource Display}" FontSize="76" FontWeight="Light" Margin="14,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Border x:Name="WeatherAirBadge" Height="20" MaxWidth="184" Margin="18,94,14,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Visibility="Collapsed">
                                    <TextBlock x:Name="WeatherAir" TextTrimming="CharacterEllipsis" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Green}" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="18,0,0,16" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="WeatherSky" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="WeatherRange" Margin="0,2,0,0" FontSize="13" Foreground="{StaticResource Dim}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Width="270" Height="177" Margin="240,46,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#14FFFFFF" CornerRadius="22">
                            <Grid>
                                <TextBlock x:Name="WeatherDaysTitle" Style="{StaticResource Caption}" Text="ПРОГНОЗ НА 5 ДНЕЙ" Margin="16,14,0,0" VerticalAlignment="Top"/>
                                <Border x:Name="WeatherDaysView" Margin="0,38,0,13" ClipToBounds="True" Background="Transparent">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="0,126">
                                            <GradientStop x:Name="WeatherDaysEdgeTop" Color="Black" Offset="0"/>
                                            <GradientStop Color="Black" Offset="0.08"/>
                                            <GradientStop Color="Black" Offset="0.92"/>
                                            <GradientStop x:Name="WeatherDaysEdgeBottom" Color="Black" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                    <Canvas x:Name="WeatherDays" Width="238" Margin="16,0,16,0" VerticalAlignment="Top"><Canvas.RenderTransform><TranslateTransform x:Name="WeatherDaysMove"/></Canvas.RenderTransform></Canvas>
                                </Border>                            </Grid>
                        </Border>

                        <Border Width="498" Height="158" Margin="12,235,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#14FFFFFF" CornerRadius="22">
                            <Grid>
                                <TextBlock Style="{StaticResource Caption}" Text="ПРОГНОЗ НА 24 ЧАСА" Margin="16,14,0,0" VerticalAlignment="Top"/>
                                <Border x:Name="WeatherStrip" Margin="0,36,0,8" ClipToBounds="True" Background="Transparent">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="498,0">
                                            <GradientStop x:Name="WeatherEdgeLeft" Color="Black" Offset="0"/>
                                            <GradientStop Color="Black" Offset="0.05"/>
                                            <GradientStop Color="Black" Offset="0.95"/>
                                            <GradientStop x:Name="WeatherEdgeRight" Color="Black" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                    <Canvas x:Name="WeatherHours" Width="498" Height="114" HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <Canvas.RenderTransform>
                                            <TranslateTransform x:Name="WeatherMove"/>
                                        </Canvas.RenderTransform>
                                    </Canvas>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel x:Name="WeatherNotice" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
                        <TextBlock x:Name="WeatherNoticeText" FontSize="15" Foreground="{StaticResource Dim}" TextAlignment="Center" HorizontalAlignment="Center"/>
                        <Button x:Name="WeatherNoticeAction" Style="{StaticResource ChipButton}" Focusable="True" Height="30" Margin="0,14,0,0" Click="WeatherNotice_Click">
                            <TextBlock x:Name="WeatherNoticeActionText" Margin="16,0" Foreground="{StaticResource Dim}"/>
                        </Button>
                    </StackPanel>

                    <Grid x:Name="WeatherFooter">
                        <Button Style="{StaticResource ChipButton}" Focusable="True" Width="34" Height="34" Margin="22,0,0,14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="WeatherList_Click" AutomationProperties.Name="Управление городами">
                            <local:Icon Kind="Lines" Width="14" Height="14" Fill="{StaticResource Dim}"/>
                        </Button>
                        <Border x:Name="WeatherCityButton" Background="#26E3F0FF" CornerRadius="15" MinWidth="64" Height="34" Margin="0,0,0,14" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal" Margin="12,0">
                                <local:WeatherActionBorder x:Name="WeatherHomeHit" Background="Transparent" Cursor="Hand" Padding="6,8,8,8">
                                    <local:Icon x:Name="WeatherAutoIcon" Kind="Location" Width="12" Height="12" Fill="{StaticResource Faint}" VerticalAlignment="Center"/>
                                </local:WeatherActionBorder>
                                <StackPanel x:Name="WeatherDots" Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="WeatherCityName" Margin="6,0,0,0" FontSize="13" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <!-- WeatherCityName moved inside the plate -->
                        <Button Style="{StaticResource ChipButton}" Focusable="True" Width="34" Height="34" Margin="0,0,22,14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="WeatherAdd_Click" AutomationProperties.Name="Добавить город">
                            <local:Icon Kind="Plus" Width="14" Height="14" Fill="{StaticResource Dim}"/>
                        </Button>
                    </Grid>

                    <Grid x:Name="WeatherCityPage" Visibility="Collapsed" Margin="22,14,22,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/><RowDefinition Height="14"/>
                            <RowDefinition Height="40"/><RowDefinition Height="20"/>
                            <RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="40"/>
                        </Grid.RowDefinitions>
                        <Button Style="{StaticResource ChipButton}" Focusable="True" Width="34" Height="34" HorizontalAlignment="Left" Click="WeatherManageClose_Click" AutomationProperties.Name="Закрыть управление городами"><local:Icon Kind="Cross" Width="12" Height="12"/></Button>
                        <Grid Grid.Row="2">
                            <TextBox x:Name="WeatherSearch" FontSize="14" Style="{StaticResource IslandTextBox}" Height="40" Padding="36,0,12,0" VerticalContentAlignment="Center" MaxLength="100" AutomationProperties.Name="Поиск местоположения"/>
                            <local:Icon Kind="Search" Width="14" Height="14" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{StaticResource Dim}" IsHitTestVisible="False"/>
                            <TextBlock x:Name="WeatherSearchHint" Text="Введите местоположение" Foreground="{StaticResource Dim}" FontSize="14" Margin="54,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                        <TextBlock x:Name="WeatherSearchMessage" Grid.Row="3" FontSize="14" Foreground="{StaticResource Dim}" Margin="14,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <ScrollViewer x:Name="WeatherCitiesScroll" Grid.Row="4" Padding="0,0,12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource IslandScrollBar}"/></ScrollViewer.Resources>
                            <local:RowList x:Name="WeatherCityList"/>
                        </ScrollViewer>
                        <Button Grid.Row="6" Style="{StaticResource ChipButton}" Focusable="True" Height="40" FontSize="14" x:Name="WeatherAutomaticButton" Click="WeatherAutomatic_Click">
                            <TextBlock Text="Определять расположение автоматически" Foreground="{StaticResource Dim}"/>
                        </Button>
                    </Grid>
                </Grid>

                <Grid x:Name="LyricsSourcesView" Width="360" Height="306" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid Margin="10,8,10,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/><RowDefinition Height="28"/>
                            <RowDefinition Height="*"/><RowDefinition Height="36"/><RowDefinition Height="30"/>
                        </Grid.RowDefinitions>
                        <local:RowList><Button Style="{StaticResource BackButton}" Content="ИСТОЧНИКИ ТЕКСТА" Click="LyricsSourcesBack_Click"/></local:RowList>
                        <TextBlock x:Name="LyricsSourcesTitle" Grid.Row="1" Margin="12,0" FontSize="12" Foreground="{StaticResource Dim}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                        <ScrollViewer x:Name="LyricsSourceScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="LyricsSourceScroll_MouseWheel">
                            <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource IslandScrollBar}"/></ScrollViewer.Resources>
                            <StackPanel x:Name="LyricsSourceRows" Margin="3,2,3,2"/>
                        </ScrollViewer>
                        <TextBlock x:Name="LyricsDiagnosticsCaption" Grid.Row="2" Text="ОТЧЁТ ПОИСКА" Style="{StaticResource Caption}"
                                   Visibility="Collapsed" VerticalAlignment="Top" Margin="12,4,0,0"/>
                        <TextBox x:Name="LyricsSourceDiagnostics" Grid.Row="2" Style="{StaticResource DiagnosticsBox}" IsReadOnly="True"
                                 IsReadOnlyCaretVisible="True" Visibility="Collapsed" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                 Padding="12,10" Margin="2,24,2,4" VerticalScrollBarVisibility="Auto"
                                 PreviewMouseWheel="LyricsSourceScroll_MouseWheel"/>
                        <UniformGrid x:Name="LyricsSourceActions" Grid.Row="3" Rows="1" Margin="2,6,2,0">
                            <Button x:Name="LyricsSourceRetry" Style="{StaticResource ChipButton}" Content="Повторить" FontSize="11" Click="LyricsSourceRetry_Click" ToolTip="Повторить поиск текста"/>
                            <Button x:Name="LyricsSourceEdit" Style="{StaticResource ChipButton}" Content="Поиск вручную" FontSize="11" Click="LyricsSourceEdit_Click" ToolTip="Изменить поисковый запрос"/>
                            <Button x:Name="LyricsSourceOriginal" Style="{StaticResource ChipButton}" Content="Оригинал" FontSize="11" Click="LyricsSourceOriginal_Click" ToolTip="Открыть оригинальный текст"/>
                        </UniformGrid>
                        <Button x:Name="LyricsDiagnosticsCopy" Grid.Row="3" Style="{StaticResource ChipButton}" Content="Скопировать отчёт"
                                Visibility="Collapsed" Height="32" Margin="2,6,2,0" Click="LyricsDiagnosticsCopy_Click"/>
                        <Button x:Name="LyricsSourceDiagnosticAction" Grid.Row="4" Style="{StaticResource ChipButton}" Content="Диагностика" FontSize="10"
                                Background="Transparent" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" Click="LyricsSourceDiagnostic_Click"/>
                    </Grid>
                </Grid>


                <Grid x:Name="LyricsManualView" Width="380" Height="284" HorizontalAlignment="Center" VerticalAlignment="Top"
                      PreviewKeyDown="LyricsManual_PreviewKeyDown">
                    <Grid Margin="10,8,10,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/><RowDefinition Height="42"/><RowDefinition Height="22"/><RowDefinition Height="38"/>
                            <RowDefinition Height="26"/><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="40"/>
                        </Grid.RowDefinitions>
                        <local:RowList><Button Style="{StaticResource BackButton}" Content="ПОИСК ТЕКСТА" Click="LyricsManualBack_Click"/></local:RowList>
                        <TextBlock Grid.Row="1" Margin="12,2,12,0" FontSize="11" Foreground="{StaticResource Dim}" TextWrapping="Wrap"
                                   Text="Введите исполнителя и название. Поиск выполнится точно по вашему запросу."/>
                        <TextBlock Grid.Row="2" Margin="12,3,0,0" FontSize="11" Foreground="{StaticResource Dim}" Text="Исполнитель"/>
                        <TextBox x:Name="LyricsManualArtist" Grid.Row="3" Style="{StaticResource MaterialInput}" Margin="2,0"/>
                        <TextBlock Grid.Row="4" Margin="12,8,0,0" FontSize="11" Foreground="{StaticResource Dim}" Text="Название трека"/>
                        <TextBox x:Name="LyricsManualTitle" Grid.Row="5" Style="{StaticResource MaterialInput}" Margin="2,0"/>
                        <UniformGrid Grid.Row="7" Rows="1" Margin="2,4,2,0">
                            <Button Style="{StaticResource ChipButton}" Content="Сбросить" FontSize="11.5" Height="36" Click="LyricsManualReset_Click"/>
                            <Button Style="{StaticResource ChipButton}" Content="Найти текст" FontSize="11.5" Height="36" FontWeight="SemiBold"
                                    Background="#E8FFFFFF" Foreground="#181818" Click="LyricsManualFind_Click"/>
                        </UniformGrid>
                    </Grid>
                </Grid>

                <Grid x:Name="LyricsView" Width="440" Height="340" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel Margin="10,8,10,0" VerticalAlignment="Top">
                        <local:RowList>
                            <Button Style="{StaticResource BackButton}" Content="ТЕКСТ ПЕСНИ" Click="LyricsBack_Click"/>
                        </local:RowList>
                        <TextBlock x:Name="LyricsEditorTitle" FontSize="12" Foreground="{StaticResource Dim}" Margin="12,0,12,6"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBox x:Name="LyricsEditor" Style="{StaticResource IslandTextBox}" Height="206" Margin="2,0"
                                 FontSize="13" Padding="12,9,6,9" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxLength="200000"
                                 SpellCheck.IsEnabled="False" TextChanged="LyricsEditor_TextChanged"
                                 PreviewKeyDown="LyricsEditor_KeyDown" PreviewMouseWheel="LyricsEditor_PreviewMouseWheel"/>
                        <TextBlock x:Name="LyricsEditorNote" FontSize="11" Foreground="{StaticResource Dim}" Height="30"
                                   Margin="12,6,12,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                        <UniformGrid Rows="1" Margin="2,4,2,0">
                            <Button Style="{StaticResource ChipButton}" Content="В Блокноте" Height="30" Click="LyricsNotepad_Click"/>
                            <Button Style="{StaticResource ChipButton}" Content="Сохранить как…" Height="30" Click="LyricsSave_Click"/>
                            <Button x:Name="LyricsEditorReset" Style="{StaticResource ChipButton}" Content="Вернуть оригинал" Height="30"
                                    Click="LyricsReset_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Grid>

                <Grid x:Name="QrView" Width="320" Height="104" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel Margin="10,8,10,0" VerticalAlignment="Top">
                        <local:RowList>
                            <Button Style="{StaticResource BackButton}" Content="QR-КОД С ЭКРАНА" Click="SettingsBack_Click"/>
                        </local:RowList>
                        <UniformGrid Rows="1" Margin="2,4,2,0">
                            <Button Style="{StaticResource ChipButton}" Height="40" FontSize="13.5" FontWeight="SemiBold"
                                    Content="Весь экран" Click="QrScreen_Click"/>
                            <Button Style="{StaticResource ChipButton}" Height="40" FontSize="13.5" FontWeight="SemiBold"
                                    Content="Выбрать область" Click="QrArea_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Grid>

            <Canvas x:Name="Shared" Visibility="Collapsed" Opacity="0">
                <Grid x:Name="ArtSpot" Width="64" Height="64" MouseLeftButtonUp="Art_MouseLeftButtonUp">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ArtSize"/>
                            <TranslateTransform x:Name="ArtMove"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Border Background="{StaticResource ArtPlaceholder}">
                        <local:Icon Kind="Note" Width="30" Height="30" Fill="{StaticResource Dim}"/>
                    </Border>
                    <local:Cover x:Name="Art" Radius="16"/>
                </Grid>
                <local:Equalizer x:Name="Eq" Bars="8" Few="5" Width="21" Height="16" IsHitTestVisible="False">
                    <local:Equalizer.RenderTransform>
                        <TranslateTransform x:Name="EqMove"/>
                    </local:Equalizer.RenderTransform>
                </local:Equalizer>
            </Canvas>
        </Grid>

        <Border x:Name="Bubble" Width="78" Height="34" CornerRadius="17" Visibility="Collapsed"
                Background="Transparent" Padding="1"
                HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0,0"
                MouseEnter="Bubble_MouseEnter" MouseLeave="Bubble_MouseLeave"
                MouseLeftButtonDown="Bubble_MouseLeftButtonDown" MouseLeftButtonUp="Bubble_MouseLeftButtonUp">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BubbleScale"/>
                    <TranslateTransform x:Name="BubbleMove"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Grid x:Name="BubbleBody" ClipToBounds="True">
                <Grid x:Name="BubbleRecord" Width="76" HorizontalAlignment="Left">
                    <Ellipse x:Name="BubbleRecordDot" Width="9" Height="9" Fill="{StaticResource Red}"
                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <local:Digits x:Name="BubbleRecordText" Text="0:00" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Red}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                </Grid>
                <Grid x:Name="BubbleTimer" Width="76" HorizontalAlignment="Left">
                    <local:Ring x:Name="BubbleRing" Width="16" Height="16"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <local:Digits x:Name="BubbleText" Text="25:00" FontSize="12.5" FontWeight="SemiBold"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                </Grid>
                <StackPanel x:Name="BubbleShelf" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,13,0">
                    <StackPanel x:Name="BubbleWeather" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center"><StackPanel.RenderTransform><TranslateTransform X="2"/></StackPanel.RenderTransform><local:Icon x:Name="BubbleWeatherIcon" Kind="Cloud" Width="15" Height="15"/><local:Digits x:Name="BubbleWeatherDegrees" FontSize="12.5" FontWeight="SemiBold" Margin="4,0,0,0"/></StackPanel><StackPanel x:Name="BubbleShelfCount" Orientation="Horizontal"><local:Icon Kind="Tray" Width="15" Height="15" VerticalAlignment="Center"/>
                    <local:Digits x:Name="BubbleShelfText" Text="0" FontSize="12.5" FontWeight="SemiBold"
                                  VerticalAlignment="Center" Margin="4,0,0,0"/></StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Border x:Name="DiscordDetachedVoice" Width="64" Height="34" Visibility="Collapsed" Background="Transparent"
                MouseEnter="DiscordDetachedVoiceEnter" MouseLeave="DiscordDetachedVoiceLeave"
                MouseLeftButtonDown="DiscordDetachedVoiceDown" MouseLeftButtonUp="DiscordDetachedVoiceUp"
                HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False" RenderTransformOrigin="0,0">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="DiscordDetachedVoiceScale"/>
                    <TranslateTransform x:Name="DiscordDetachedVoiceMove"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Grid x:Name="DiscordDetachedVoiceContent" ClipToBounds="True"/>
        </Border>
    </Grid>
</Window>
